{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "provider": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": { "options": { "reasoningEffort": "high" } }
      }
    }
  },
  "instructions": ["CLAUDE.md", "AGENTS.md", "README.md"],
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "edit": {
      "*": "allow",
      "*.env": "deny", "*.env.*": "deny", ".env*": "deny", "env.*": "deny",
      "**/secrets/**": "deny", "*.pem": "deny", "*.p8": "deny", "*.p12": "deny",
      "*.keystore": "deny", "*.jks": "deny", "key.properties": "deny", "local.properties": "deny",
      "google-services.json": "deny", "GoogleService-Info.plist": "deny",
      "*service-account*.json": "deny", "id_rsa*": "deny", "id_ed25519*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny", "*.env.*": "deny", ".env*": "deny", "env.*": "deny",
      "**/secrets/**": "deny", "*.pem": "deny", "*.p8": "deny", "*.p12": "deny",
      "*.keystore": "deny", "*.jks": "deny", "key.properties": "deny", "local.properties": "deny",
      "google-services.json": "deny", "GoogleService-Info.plist": "deny",
      "*service-account*.json": "deny", "id_rsa*": "deny", "id_ed25519*": "deny",
      "*.example": "allow", ".env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "cat *.env*": "deny", "cat *secrets/*": "deny", "cat *.pem": "deny", "cat *.p8": "deny",
      "head *.env*": "deny", "tail *.env*": "deny", "less *.env*": "deny", "more *.env*": "deny",
      "grep * .env*": "deny", "rg -uuu *": "deny", "printenv*": "deny", "env": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny"
  }
}
